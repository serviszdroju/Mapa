rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function astipUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@astip\\.cz$');
    }

    function ownEmail() {
      return request.auth.token.email;
    }

    match /sitesUnified/{docId} {
      allow read, write: if astipUser();
    }

    match /siteEdits/{docId} {
      allow read, write: if astipUser();
    }

    match /sites/{docId} {
      allow read, write: if astipUser();
    }

    match /deletedSites/{docId} {
      allow read, write: if astipUser();
    }

    match /serviceRecords/{docId} {
      allow read, write: if astipUser();
    }

    match /protocols/{docId} {
      allow read, write: if astipUser();
    }

    match /technicianSignatures/{docId} {
      allow read: if astipUser()
        && (docId == ownEmail() || resource.data.email == ownEmail());
      allow create, update: if astipUser()
        && docId == ownEmail()
        && request.resource.data.email == ownEmail();
      allow delete: if astipUser()
        && docId == ownEmail();
    }
  }
}
